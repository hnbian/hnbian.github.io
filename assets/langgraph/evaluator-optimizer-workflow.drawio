<mxfile host="Electron" agent="draw.io">
  <diagram id="evaluator-optimizer" name="评估器优化器 Workflow">
    <mxGraphModel dx="1201" dy="1321" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="430" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#172554;" value="评估器优化器 Workflow" vertex="1">
          <mxGeometry height="36" width="1120" x="30" y="-50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=14;fontColor=#64748B;" value="生成内容 → 结构化评估 → 接受、重试或达到次数上限" vertex="1">
          <mxGeometry height="24" width="1120" x="30" y="-12" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontFamily=Helvetica;fontSize=15;fontStyle=0;" value="START" vertex="1">
          <mxGeometry height="68" width="68" x="40" y="160" as="geometry" />
        </mxCell>
        <mxCell id="generate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontFamily=Helvetica;fontSize=16;spacing=8;fontStyle=0" value="&lt;span&gt;generate_joke&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;生成或根据反馈改写&lt;/font&gt;" vertex="1">
          <mxGeometry height="82" width="190" x="145" y="153" as="geometry" />
        </mxCell>
        <mxCell id="evaluate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontFamily=Helvetica;fontSize=16;spacing=8;fontStyle=0" value="&lt;span&gt;evaluate_joke&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;返回 grade 与 feedback&lt;/font&gt;" vertex="1">
          <mxGeometry height="82" width="190" x="390" y="153" as="geometry" />
        </mxCell>
        <mxCell id="route" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontFamily=Helvetica;fontSize=16;spacing=6;fontStyle=0" value="&lt;span&gt;路由判断&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;grade 与 attempts&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="170" x="650" y="135" as="geometry" />
        </mxCell>
        <mxCell id="finish" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontFamily=Helvetica;fontSize=16;spacing=8;fontStyle=0" value="&lt;span&gt;finish&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;写入 stop_reason&lt;/font&gt;" vertex="1">
          <mxGeometry height="82" width="160" x="910" y="153" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontFamily=Helvetica;fontSize=15;fontStyle=0;" value="END" vertex="1">
          <mxGeometry height="68" width="68" x="1120" y="160" as="geometry" />
        </mxCell>
        <mxCell id="state-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;strokeWidth=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;" value="&lt;b&gt;State&lt;/b&gt; 在循环中持续传递：joke · grade · feedback · attempts" vertex="1">
          <mxGeometry height="44" width="500" x="350" y="550" as="geometry" />
        </mxCell>
        <mxCell id="edge-start-generate" edge="1" parent="1" source="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1;strokeColor=#000000;fontColor=#000000;fontStyle=0" target="generate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-generate-evaluate" edge="1" parent="1" source="generate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1;strokeColor=#000000;fontColor=#000000;fontStyle=0" target="evaluate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-evaluate-route" edge="1" parent="1" source="evaluate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1;strokeColor=#000000;fontColor=#000000;fontStyle=0" target="route">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-accepted" edge="1" parent="1" source="route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#000000;labelBackgroundColor=#FFFFFF;" target="finish" value="接受">
          <mxGeometry relative="1" x="-0.04" y="-12" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-max-attempts" edge="1" parent="1" source="route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="finish" value="最大生成次数">
          <mxGeometry relative="1" x="-0.1" y="10" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="735" y="295" />
              <mxPoint x="990" y="295" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-finish-end" edge="1" parent="1" source="finish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1;strokeColor=#000000;fontColor=#000000;fontStyle=0" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-retry" edge="1" parent="1" source="route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="generate" value="重试：携带 feedback 重新生成">
          <mxGeometry relative="1" x="0.05" y="-10" as="geometry">
